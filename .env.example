# ==========================================
# BLOGGER RECIPE PUBLISHER CONFIGURATION
# ==========================================

# 1. Google Gemini API (for deep culinary recipe generation)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Blogger "Post using email" Secret Address
# In Blogger Dashboard: Settings > Email > "Post using email"
# Example: myfoodblog.secretword123@blogger.com
# IMPORTANT: Make sure you select "Save emails as draft post" in Blogger Settings!
BLOGGER_SECRET_EMAIL=myblog.secret123@blogger.com

# 3. Your Sender Email Credentials (e.g. your Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_character_app_password

# 4. Blog Information
BLOG_NAME=Global Flavor Roots
BLOG_AUTHOR=Chef & Food Enthusiast
AUTO_GENERATE_IMAGE=false

# 5. Simulation Mode
# Set to 'false' when ready to send live drafts to Blogger.
# When 'true', generates HTML files in output/ for inspection without sending emails.
SIMULATION_MODE=true

# 6. Daily Automation Schedule
DAILY_BATCH_SIZE=10
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
